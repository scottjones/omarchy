#!/bin/bash

# omarchy:summary=Shift+brightness: keyboard backlight on Apple Silicon, display max/min otherwise
# omarchy:args=<up|down>
# omarchy:hidden=true

case ${1:-} in
  up)
    if omarchy-hw-apple-silicon; then
      omarchy-brightness-keyboard up
    else
      omarchy-brightness-display 100%
    fi
    ;;
  down)
    if omarchy-hw-apple-silicon; then
      omarchy-brightness-keyboard down
    else
      omarchy-brightness-display 1%
    fi
    ;;
  *)
    echo "Usage: omarchy-brightness-shift <up|down>" >&2
    exit 2
    ;;
esac
