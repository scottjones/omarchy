#!/bin/bash

# omarchy:summary=Install 1Password and its Chromium extension.
# omarchy:requires-sudo=true

set -euo pipefail

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"
EXTENSION_DIR="/usr/share/chromium/extensions"
EXTENSION_FILE="$EXTENSION_DIR/$EXTENSION_ID.json"
WEBSTORE_UPDATE_URL="https://clients2.google.com/service/update2/crx"

VERSION="8.12.0"
ARCH_SUFFIX="arm64"
INSTALL_DIR="${OMARCHY_1PASSWORD_INSTALL_DIR:-/opt/1Password}"
BIN_LINK="${OMARCHY_1PASSWORD_BIN_LINK:-/usr/local/bin/1password}"
GROUP_NAME="onepassword"

install_chromium_extension() {
  if omarchy-cmd-missing chromium; then
    echo "Chromium is not installed; skipping 1Password Chromium extension."
    return
  fi

  sudo mkdir -p "$EXTENSION_DIR"
  printf '{ "external_update_url": "%s" }\n' "$WEBSTORE_UPDATE_URL" | sudo tee "$EXTENSION_FILE" >/dev/null
  sudo chmod 644 "$EXTENSION_FILE"
}

# The browser extension unlocks from the desktop app through
# 1Password-BrowserSupport, which 1Password only trusts when it is setgid to
# the onepassword group. The official package does this from its .install
# hooks; the tarball ships none, so without this the extension cannot reach
# the app. Do not add your user to this group.
setup_browser_helper() {
  local browser_support="$INSTALL_DIR/1Password-BrowserSupport"

  if ! getent group "$GROUP_NAME" >/dev/null; then
    echo "Creating the $GROUP_NAME group..."
    sudo groupadd "$GROUP_NAME"
  fi

  [[ -f $browser_support ]] || return 0
  sudo chgrp "$GROUP_NAME" "$browser_support"
  sudo chmod g+s "$browser_support"
}

link_1password() {
  if OMARCHY_ELECTRON_GL_BIND_DIR=$(dirname "$BIN_LINK") \
    omarchy-cmd-electron-gl-wrap "$(basename "$BIN_LINK")" "$INSTALL_DIR/1password"; then
    desktop=${OMARCHY_1PASSWORD_DESKTOP:-/usr/share/applications/1password.desktop}
    omarchy-cmd-desktop-exec-repair "$HOME/.local/share/applications/1password.desktop" \
      "$desktop" "$BIN_LINK" "$INSTALL_DIR/1password" 1password
  else
    status=$?
    if ((status == 3)); then
      echo "Preserving administrator-owned 1Password launcher; desktop repair skipped" >&2
    else
      return "$status"
    fi
  fi
}

install_aarch64() {
  if [[ -e $BIN_LINK && -d $INSTALL_DIR ]]; then
    echo "1Password already installed"
    setup_browser_helper
    return 0
  fi

  echo "Installing 1Password $VERSION for aarch64..."
  local tmpdir
  tmpdir=$(mktemp -d)
  trap 'rm -rf "$tmpdir"' RETURN

  curl -fsSL "https://downloads.1password.com/linux/tar/stable/aarch64/1password-${VERSION}.arm64.tar.gz" \
    -o "$tmpdir/1password.tar.gz"
  tar -xzf "$tmpdir/1password.tar.gz" -C "$tmpdir"

  sudo rm -rf "$INSTALL_DIR"
  sudo mv "$tmpdir/1password-${VERSION}.${ARCH_SUFFIX}" "$INSTALL_DIR"
  sudo chown -R root:root "$INSTALL_DIR"
  sudo chmod 4755 "$INSTALL_DIR/chrome-sandbox"

  sudo mkdir -p /usr/share/applications
  sudo cp "$INSTALL_DIR/resources/1password.desktop" /usr/share/applications/

  for size in 32x32 64x64 256x256 512x512; do
    sudo mkdir -p "/usr/share/icons/hicolor/${size}/apps"
    sudo cp "$INSTALL_DIR/resources/icons/hicolor/${size}/apps/1password.png" \
      "/usr/share/icons/hicolor/${size}/apps/" 2>/dev/null || true
  done
  sudo gtk-update-icon-cache -f /usr/share/icons/hicolor/ 2>/dev/null || true

  if [[ -f $INSTALL_DIR/com.1password.1Password.policy.tpl ]]; then
    POLICY_OWNERS=$(cut -d: -f1,3 /etc/passwd | grep -E ':[0-9]{4}$' | cut -d: -f1 | head -n 10 | sed 's/^/unix-user:/' | tr '\n' ' ')
    sudo bash -c "export POLICY_OWNERS='${POLICY_OWNERS}'; eval \"cat <<EOF
\$(cat ${INSTALL_DIR}/com.1password.1Password.policy.tpl)
EOF\" > /usr/share/polkit-1/actions/com.1password.1Password.policy"
  fi

  setup_browser_helper
  link_1password
}

echo "Installing 1Password..."
if [[ $(uname -m) == aarch64 ]]; then
  install_aarch64
else
  omarchy-pkg-add 1password 1password-cli
fi

echo "Installing 1Password extension for Chromium..."
install_chromium_extension

if omarchy-cmd-present 1password; then
  echo "Opening 1Password..."
  uwsm-app -- 1password >/dev/null 2>&1 &
fi

echo ""
echo "1Password has been installed. Restart Chromium to load the browser extension."
